# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ── Database ────────────────────────────────────────────
# Default: SQLite, zero-config, stored as a local file.
DATABASE_URL="file:./dev.db"
# For PostgreSQL/MySQL in production, replace with e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
# DATABASE_URL="mysql://user:password@host:3306/dbname"
# (also change `provider` in prisma/schema.prisma to match)

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Used only once, by `npm run seed`, to create the first admin login.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe123!

# ── Email notifications (SMTP) ─────────────────────────
# Leave blank to disable email sending — messages are still saved to the DB.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com
